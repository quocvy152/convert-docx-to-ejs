# Copy to .env and point at LOCAL / STAGING only — never production credentials.
PORT=4050

# Shared CRM MySQL (same key names as sunbrightvn_api)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=your_local_db
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# Where published .ejs files are written (absolute path recommended).
# Point at sunbrightvn_api template views root if you want main API to pick them up:
# e.g. C:/Users/you/Documents/sunbrightvn_api/server/controllers/template
EJS_OUTPUT_DIR=./storage/published

# path_template prefix stored on file_template (must match how main API resolves views)
PATH_TEMPLATE_PREFIX=/views/mvp_generated

# Draft storage: auto | mysql | fs
# auto = use MySQL table template_builder_draft when it exists, else local JSON under storage/drafts
DRAFT_STORE=auto

# MVP auth: any of these values in header X-Template-Builder-Key is allowed
TEMPLATE_BUILDER_API_KEYS=dev-key-change-me

# Optional: if set, Bearer JWT must decode with this secret and include a matching permission value
# JWT_SECRET=
# REQUIRED_PERMISSION=FILE_TEMPLATE_CONFIG
